{
  "name": "Munkalap",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "Munkalap k\u00f3d"
    },
    "customer_name": {
      "type": "string",
      "title": "Vev\u0151 megnevez\u00e9se"
    },
    "operation": {
      "type": "string",
      "enum": [
        "egyengetes",
        "bordazas",
        "hajlitas",
        "meretre_vagas",
        "halo_hegesztes"
      ],
      "title": "M\u0171velet",
      "default": "egyengetes"
    },
    "quantity_kg": {
      "type": "number",
      "title": "Mennyis\u00e9g (kg)",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "terv_feldolgozas",
        "elfogadasra_var",
        "gyartas_folyamatban",
        "rakodasra_elojegyezve",
        "felrakva_kesz"
      ],
      "title": "St\u00e1tusz",
      "default": "terv_feldolgozas"
    },
    "accepted": {
      "type": "boolean",
      "title": "Elfogadva",
      "default": false
    },
    "elfogadva_at": {
      "type": "string",
      "title": "Elfogad\u00e1s id\u0151pontja (ISO)"
    },
    "flagged": {
      "type": "boolean",
      "title": "Kiemelt / Jel\u00f6lt",
      "default": false
    },
    "archived": {
      "type": "boolean",
      "title": "Archiv\u00e1lt",
      "default": false
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Dokumentumok (URL)"
    },
    "stage_history": {
      "type": "array",
      "title": "Folyamat napl\u00f3 (f\u00e1zis v\u00e1lt\u00e1sok)",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "title": "F\u00e1zis"
          },
          "at": {
            "type": "string",
            "title": "Id\u0151pont (ISO)"
          },
          "note": {
            "type": "string",
            "title": "Megjegyz\u00e9s"
          }
        }
      }
    },
    "progress": {
      "type": "number",
      "title": "El\u0151rehalad\u00e1s (%)",
      "default": 10
    },
    "description": {
      "type": "string",
      "title": "Le\u00edr\u00e1s"
    },
    "terv_hatarido": {
      "type": "string",
      "format": "date",
      "title": "Terv feldolgoz\u00e1s hat\u00e1rideje (vev\u0151 k\u00e9r\u00e9s)"
    },
    "gyartasi_datum": {
      "type": "string",
      "format": "date",
      "title": "Gy\u00e1rt\u00e1si nap"
    },
    "kiszallitasi_datum": {
      "type": "string",
      "format": "date",
      "title": "Kisz\u00e1ll\u00edt\u00e1si d\u00e1tum"
    },
    "felelos": {
      "type": "string",
      "title": "Felel\u0151s / Terv feldolgoz\u00f3"
    }
  },
  "required": [
    "code",
    "customer_name",
    "operation"
  ]
}