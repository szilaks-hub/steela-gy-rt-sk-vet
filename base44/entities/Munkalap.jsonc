        "feldolgozas_alatt",
        "elkeszitve",
        "vevoi_dontes",
        "gyartasra_kiadva",
        "gyartasban",
        "rakodhato",
        "lezarva",
        "megszakitva"
      ],
      "title": "St\u00e1tusz",
