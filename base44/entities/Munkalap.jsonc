{
  "name": "Munkalap",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "title": "Munkalap azonos\u00edt\u00f3 (ST-YYMMDD-NNN)"
    },
    "customer_name": {
      "type": "string",
      "title": "Vev\u0151 megnevez\u00e9se"
    },
    "project_name": {
      "type": "string",
      "title": "Projekt megnevez\u00e9se"
    },
    "letrehozo_nev": {
      "type": "string",
      "title": "L\u00e9trehoz\u00f3 (keresked\u0151, automatikus)"
    },
    "kereskedo": {
      "type": "string",
      "title": "Keresked\u0151"
    },
    "keres_tipus": {
      "type": "string",
      "enum": [
        "halo_rajz",
        "hajlitasi_terv",
        "mennyiseg",
        "gyarthatosag",
        "egyengetes",
        "bordazas",
        "meretre_vagas",
        "halo_hegesztes",
        "arajanlat",
        "egyeb"
      ],
      "title": "K\u00e9r\u00e9s t\u00edpusa",
      "default": "egyeb"
    },
    "operation": {
      "type": "string",
      "enum": [
        "egyengetes",
        "bordazas",
        "hajlitas",
        "meretre_vagas",
        "halo_hegesztes"
      ],
      "title": "Gy\u00e1rt\u00e1si m\u0171velet",
      "default": "egyengetes"
    },
    "quantity_kg": {
      "type": "number",
